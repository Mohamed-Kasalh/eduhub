# Set to "true" to enable the in-browser MSW mock server; set to "false" for a real backend API.
VITE_USE_MOCK=false

# Base URL for REST API calls (relative proxy path or full backend origin).
VITE_API_BASE_URL=/api/v1

# Optional mock server behavior (active only when VITE_USE_MOCK=true).
VITE_MOCK_PERSIST=false
VITE_MOCK_ERROR_RATE=0
